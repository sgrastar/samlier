# Files that serve as trust anchors for the approval protocol.
# Unless branch protection requires CODEOWNERS review,
# rewriting these files disables the entire gate.

# The CI definitions themselves (the final trust anchor)
/.github/                     @sgrastar

# Validators and execution entry points
/tools/g1_validate.py         @sgrastar
/tools/g1_trusted_verify.py   @sgrastar
/tools/g1_extract.py          @sgrastar
/tools/g1_ci_verify.sh         @sgrastar
/tools/g1_docgen.py           @sgrastar
/tools/g1_migration_validate.py @sgrastar
/tools/g1_schema_validate.py  @sgrastar
/tools/g1_language_check.py   @sgrastar
/tools/g1-semantic-exceptions.yaml @sgrastar
/schema/                      @sgrastar

# ★ Dependencies. Included as trust anchors because they determine the code executed before signature verification.
/tools/requirements.txt       @sgrastar
/tools/requirements.lock      @sgrastar

# G2 design gate and signed approval verifier
/tools/g2_validate.py         @sgrastar
/tools/g2_trusted_verify.py   @sgrastar
/tools/g2_ci_verify.sh        @sgrastar
/.github/workflows/g2.yml     @sgrastar

# Approved artifacts
/tests/                       @sgrastar
