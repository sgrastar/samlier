# Files that serve as trust anchors for the approval protocol.
# Unless branch protection requires CODEOWNERS review,
# rewriting these files disables the entire gate.

# The CI definitions themselves (the final trust anchor)
/.github/                     @sgrastar

# Validators and execution entry points
/tools/g1_validate.py         @sgrastar
/tools/g1_trusted_verify.py   @sgrastar
/tools/g1_extract.py          @sgrastar
/tools/g1_ci_verify.sh         @sgrastar
/tools/g1_docgen.py           @sgrastar
/tools/g1_migration_validate.py @sgrastar
/tools/g1_schema_validate.py  @sgrastar
/tools/g1_language_check.py   @sgrastar
/tools/g1-semantic-exceptions.yaml @sgrastar
/schema/                      @sgrastar

# ★ Dependencies. Included as trust anchors because they determine the code executed before signature verification.
/tools/requirements.txt       @sgrastar
/tools/requirements.lock      @sgrastar
/gradle/                      @sgrastar
/build.gradle.kts             @sgrastar
/settings.gradle.kts          @sgrastar
/saml/build.gradle.kts        @sgrastar
/api/build.gradle.kts         @sgrastar
/peer/build.gradle.kts        @sgrastar

# G2 design gate and signed approval verifier
/tools/g2_validate.py         @sgrastar
/tools/g2_trusted_verify.py   @sgrastar
/tools/g2_ci_verify.sh        @sgrastar
/tools/release_check.py       @sgrastar
/tools/tests/test_release_check.py @sgrastar
/.github/workflows/g2.yml     @sgrastar
/Dockerfile                   @sgrastar
/.dockerignore                @sgrastar
/dev/keycloak/                @sgrastar

# Approved artifacts
/tests/                       @sgrastar

# Production boundaries and executable evidence bound by G2 approval
/saml/src/main/java/org/samlier/saml/binding/       @sgrastar
/saml/src/main/java/org/samlier/saml/ecp/           @sgrastar
/saml/src/main/java/org/samlier/saml/logout/        @sgrastar
/saml/src/main/java/org/samlier/saml/metadata/MetadataVariantRegistry.java @sgrastar
/saml/src/main/java/org/samlier/saml/raw/BytePreservingRawMessageBuilder.java @sgrastar
/peer/src/main/java/org/samlier/peer/PeerIdentity.java @sgrastar
/api/src/main/java/org/samlier/api/SamlierApplication.java @sgrastar
/saml/src/test/java/org/samlier/saml/G2FeasibilitySpikeTest.java @sgrastar
/peer/src/test/java/org/samlier/peer/PeerG2FeasibilityTest.java @sgrastar
