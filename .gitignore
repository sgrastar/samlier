# Build output
build/*
# Do not track the :specReconcile report.
# Its run_id, executed_at, and tools commit state change on every run, so a committed
# copy inevitably becomes stale (one was left at 53/56 with SR-40 blocking).
# The canonical copy is the CI artifact uploaded by .github/workflows/g1.yml.
out/
.gradle/
**/build/
bin/

# Original-text cache fetched by :specReconcile; exclude it from both the
# distribution and the repository. See design gate G1 in docs/04-requirement-coverage.md.
build/spec-cache/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo

# Runtime data (SQLite / generated keys / Transcript)
data/
.data/
*.db
*.db-wal
*.db-shm

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# G1 authoring input. It contains original clauses and must not be distributed.
tools/g1_authoring.py

# Python
__pycache__/
*.pyc

# repo-local venv (tools/requirements.txt)
.venv/

# Local scratch space (design mockups, drafts) — never tracked or distributed.
private/
