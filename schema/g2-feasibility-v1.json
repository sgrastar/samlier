{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samlier.dev/schema/g2-feasibility-v1.json",
  "title": "Samlier G2 feasibility spikes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spikes"],
  "properties": {
    "schema_version": {"const": 1},
    "spikes": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "target", "status", "assertions", "limitations_en"],
        "properties": {
          "id": {"pattern": "^S[1-6]$"}, "target": {"type": "string", "minLength": 2},
          "status": {"const": "PASS"},
          "assertions": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim_en", "verified_by"],
              "properties": {
                "claim_en": {"type": "string", "minLength": 10},
                "verified_by": {"type": "string", "pattern": "^[a-z]+:[A-Za-z0-9_.]+$"}
              }
            }
          },
          "limitations_en": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
