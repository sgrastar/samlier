{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samlier.dev/schema/g2-feasibility-v1.json",
  "title": "Samlier G2 feasibility spikes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spikes"],
  "properties": {
    "schema_version": {"const": 1},
    "spikes": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "target", "status", "assertions", "verified_by", "limitations_en"],
        "properties": {
          "id": {"pattern": "^S[1-6]$"}, "target": {"type": "string", "minLength": 2},
          "status": {"const": "PASS"},
          "assertions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
          "verified_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "limitations_en": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
