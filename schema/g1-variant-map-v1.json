{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samlier.example/schema/g1-variant-map-v1.json",
  "title": "Samlier G1 variant ID migration map",
  "type": "object",
  "required": ["baseline_commit", "current_commit", "count", "mappings"],
  "properties": {
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "current_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["obligation", "ordinal", "old_id", "new_id"],
        "properties": {
          "obligation": { "type": "string" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "old_id": { "type": "string" },
          "new_id": { "type": "string" }
        }
      }
    }
  }
}
