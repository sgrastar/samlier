{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samlier.dev/schema/g2-approval-v1.json",
  "title": "Samlier signed G2 approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_commit", "artifact_digests", "evidence", "approvals"],
  "properties": {
    "schema_version": {"const": 1},
    "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_digests": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reviewers", "evidence_url"],
      "properties": {
        "kind": {"const": "signed-commit"},
        "reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_url": {"type": "string", "minLength": 1}
      }
    },
    "approvals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case", "case_digest", "reviewer", "approved_at"],
        "properties": {
          "case": {"type": "string"},
          "case_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "reviewer": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
