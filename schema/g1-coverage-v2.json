{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samlier.example/schema/g1-coverage-v2.json",
  "title": "Samlier English-canonical G1 coverage catalog",
  "type": "object",
  "propertyNames": { "not": { "pattern": "_ja$" } },
  "required": ["schema_version", "g1_state", "requirements"],
  "properties": {
    "schema_version": { "const": 2 },
    "g1_state": { "enum": ["PENDING_REVIEW", "APPROVED"] },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": { "not": { "pattern": "_ja$" } },
        "required": ["id", "obligations"],
        "properties": {
          "id": { "type": "string" },
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": { "not": { "pattern": "_ja$" } },
              "required": [
                "key", "roles", "level", "testability", "summary_en",
                "required_variants", "source_clauses"
              ],
              "properties": {
                "summary_en": { "type": "string", "minLength": 1 },
                "required_variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": { "not": { "pattern": "_ja$" } },
                    "required": ["id", "description_en"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^v-[0-9a-f]{10}$" },
                      "description_en": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "linked_obligations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": { "not": { "pattern": "_ja$" } },
                    "required": ["obligation", "kind", "note_en"],
                    "properties": {
                      "obligation": { "type": "string", "minLength": 1 },
                      "kind": { "const": "inherit_variants" },
                      "variant_applicability": {
                        "enum": ["owner_condition", "linked_condition"]
                      },
                      "note_en": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "controls": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
